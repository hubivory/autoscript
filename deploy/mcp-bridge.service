[Unit]
Description=Roblox Executor MCP bridge (mcp-mobile)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/mcp-mobile
EnvironmentFile=/home/ubuntu/.mcp-bridge.env
ExecStart=/home/ubuntu/run_bridge.sh
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
